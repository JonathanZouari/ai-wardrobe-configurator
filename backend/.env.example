# Copy to backend/.env for local development. Never commit real values.
ENVIRONMENT=development
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# AI assistant (optional). Leave OPENAI_API_KEY empty to run without the assistant.
OPENAI_API_KEY=
LIVE_MODEL=gpt-live-1.1
AGENT_MODEL=gpt-5.6-terra
AI_REQUESTS_PER_MINUTE=20
